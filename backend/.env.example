# Server port
PORT=4000

# Frontend URL for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK
# Option 1 (recommended for local dev): path to downloaded service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option 2 (recommended for production / cloud): inline the JSON as a base64 string
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 encoded service account JSON>

# Firebase Project ID
FIREBASE_PROJECT_ID=quzar-io
